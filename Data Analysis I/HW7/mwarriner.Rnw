  % Question 4
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\item \textbf{Optional, but recommended} Plot the results! Create a scatterplot
of \texttt{x2} and \texttt{y2}. Superimpose the true regression line, the OLS
estimate, the IRWLS estimates, and the quantile regression estimate. Interpret
the results.

\begin{figure}[H]
\centering

<<warning=F, message=F, size='scriptsize', fig.dim=c(7,4)>>=

ggplot(data = second_dat, aes(x = x, y = y)) + 
  geom_point() + 
  geom_abline(aes(intercept = second_sum$Estimate[1], 
                  slope = second_sum$Estimate[2], 
                  color = "OLS")) + 
  geom_abline(aes(intercept = IWH_sum$Estimate[1], 
                  slope = IWH_sum$Estimate[2], 
                  color = "Huber IRWLS")) + 
  geom_abline(aes(intercept = IWB_sum$Estimate[1], 
                  slope = IWB_sum$Estimate[2], 
                  color = "Bisquare IRWLS")) + 
  geom_abline(aes(intercept = rob_sum$Estimate[1], 
                  slope = rob_sum$Estimate[2], 
                  color = "RobustBase IRWLS")) +
  geom_abline(aes(intercept = quant_sum$Estimate[1], 
                  slope = quant_sum$Estimate[2], 
                  color = "Quantile")) + 
  geom_abline(aes(intercept = 3.5, 
                  slope = 2.1, 
                  color = "True Line")) + 
  theme_bw() + 
  labs(color = "") + 
  geom_hline(yintercept = 0, linetype = "dashed") + 
  geom_vline(xintercept = 0, linetype = "dashed") +
  ggtitle('Comparison of Model Regression Equations') + 
  scale_color_manual(values = c("OLS" = "red",
                                "Huber IRWLS" = "orange",
                                "Bisquare IRWLS" = "yellow2", 
                                "RobustBase IRWLS" = "green3", 
                                "Quantile" = "blue", 
                                "True Line" = "purple3"),
                     breaks = c("OLS",
                                "Huber IRWLS",
                                "Bisquare IRWLS", 
                                "RobustBase IRWLS", 
                                "Quantile", 
                                "True Line"))


@


\label{all.models.plot}
\caption{Scatterplot of the Data and Each Model}

\end{figure}

\textcolor{red}{When comparing all of the models visually, the only one that stands out is the standard OLS model, with very little variation amongst the true line and the robust methods.}

<<warning=F, message=F, size='scriptsize'>>=


total_sum <- tibble(Method = c("OLS", 
                               "Huber IRWLS", 
                               "Bisquare IRWLS", 
                               "RobustBase IRWLS",
                               "Quantile", 
                               "True Values"), 
                    Intercept = c(second_sum$Estimate[1],
                                  IWH_sum$Estimate[1], 
                                  IWB_sum$Estimate[1], 
                                  rob_sum$Estimate[1], 
                                  quant_sum$Estimate[1], 
                                  3.5), 
                    Slope = c(second_sum$Estimate[2],
                                  IWH_sum$Estimate[2], 
                                  IWB_sum$Estimate[2], 
                                  rob_sum$Estimate[2], 
                                  quant_sum$Estimate[2], 
                                  2.1))

total_sum <- total_sum |>
  mutate("Intercept Error" = Intercept - total_sum$Intercept[6], 
         "Slope Error" = Slope - total_sum$Slope[6])

total_sum <- total_sum[,c(1,2,4,3,5)]

total_sum <- xtable(total_sum,
                    label = "total.model.sum", 
                    caption = "Comparison of Each Model",
                    digits = 3)


@


<<results="asis", echo=F>>=
print(total_sum,
table.placement = "H", include.rownames=F, size = "normalsize")
@

\textcolor{red}{Likely coincidentally, each successive model we tested is closer to the true value than the last, with the biggest difference being after we moved from OLS to the robust methods.}


