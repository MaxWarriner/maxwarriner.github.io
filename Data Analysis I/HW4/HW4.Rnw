\end{figure}

\textcolor{red}{A similar thing happens here as well, where the histogram is weighted to the right a lot more and it doesn't fit the $\chi^2$ distribution as well.}

\item What proportion of the time did your simulation result in a statistic
in the rejection region for both tests?

<<warning=F, message=F, size="scriptsize">>=


(power_F <- mean(F.stat >= rejection_point_F))
(type2_F <- 1 - power_F)

(power_H <- mean(H.stat >= rejection_point_H))
(type2_H <- 1 - power_H)

@

\item Now, let's assume our data are a bit misbehaved. That is, redo
(a)-(c) but now generate the data from a Laplace distribution with
\texttt{location} equal to $\mu_i$ and the \texttt{scale}=$\sigma_i/\sqrt{2}$.
What do you notice?\\
\textbf{Note:} You can find \texttt{rlaplace()} in the \texttt{VGAM}
package for \texttt{R} \cite{VGAM}.

<<warning=F, message=F, size="scriptsize">>=

library(VGAM)

F.stat_lap <- rep(NA, 1000)
H.stat_lap <- rep(NA, 1000)

for (i in 1:1000){
  
x1_lap <- rlaplace(n = n1, 
                   location = mu1, 
                   scale = sigma/sqrt(2))
x2_lap <- rlaplace(n = n2, 
                   location = mu2, 
                   scale = sigma/sqrt(2))
x3_lap <- rlaplace(n = n3, 
                   location = mu3, 
                   scale = sigma/sqrt(2))
  
  # ANOVA F stat
  xbar1_lap <- mean(x1_lap)
  xbar2_lap <- mean(x2_lap)
  xbar3_lap <- mean(x3_lap)
  X_lap <- c(x1_lap, x2_lap, x3_lap)
  xbar_lap <- mean(X_lap)
  # SSBetween
  SSB_lap <- n1*(xbar1_lap-xbar_lap)^2 + n2*(xbar2_lap-xbar_lap)^2 + n3*(xbar3_lap-xbar_lap)^2
  # SSWithin
  SSW_lap <- (n1-1)*var(x1_lap) + (n2-1)*var(x2_lap) + (n3-1)*var(x3_lap)
  # F-statistic
  F.stat_lap[i] <- (SSB_lap/(k-1))/(SSW_lap/(N-k))
  
  # KW H stat
  X_lap <- c(x1_lap, x2_lap, x3_lap)
  ranks_lap <- rank(X_lap)
  r1_lap <- ranks_lap[1:length(x1_lap)]
  r2_lap <- ranks_lap[(n1+1):(n1+n2)]
  r3_lap <- ranks_lap[(n1+n2+1):N]
  # Rank Sums
  rank.sums_lap <- 12/(N*(N+1)) * (sum(r1_lap)^2/n1 + sum(r2_lap)^2/n2 + sum(r3_lap)^2/n3)
  # Ties? (Note: when there are no ties, this adjustment is 1)
  ties.adj_lap <- tibble(r=ranks_lap) |> # create a tibble
    group_by(r) |>               # group by the ranks
    summarize(n=n())|>           # count the number of unique ranks
    summarize(ties.adj = 1-sum(n^3-n)/(N^3-N))|> # compute adjustment
    pull() # convert from tibble to numeric
  # H-statistic
  H.stat_lap[i] <- (rank.sums_lap - 3*(N+1))/ties.adj_lap
  
}


